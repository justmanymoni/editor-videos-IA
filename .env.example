# Copia este archivo como .env.local y rellena lo que necesites.

# --- Transcripción -----------------------------------------------------------
# No hace falta configurar nada: la transcripción local (whisper.cpp) se instala
# con el botón "Instalar" de la app y funciona sin API ni internet.

# Opcional: tu propia instalación de whisper.cpp (ejecutable y modelo ggml)
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=
# Hilos de CPU para transcribir (por defecto, los del equipo menos uno, máx. 8)
# WHISPER_CPP_THREADS=8

# Opcional: transcribir con la API de OpenAI en lugar de en local.
# Pon tu clave y TRANSCRIBER=openai.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_BASE_URL=https://api.openai.com/v1
# openai = usar la API · vacío = local si está instalada
TRANSCRIBER=
# Idioma por defecto de la transcripción
DEFAULT_LANGUAGE=es
# Texto de contexto para que Whisper conserve muletillas ("eh", "mm"…)
# TRANSCRIPTION_PROMPT=Eh… mm, o sea, bueno, pues eh… este, mmm, vale.

# --- Rutas -------------------------------------------------------------------
# Datos de la app (clips subidos, proyectos, exportaciones)
STORAGE_DIR=./storage
# Carpeta de recursos de B-roll y música
BROLL_DIR=./recursos
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# Crear siempre una copia ligera para la vista previa (más fluida con muchos cortes)
ALWAYS_PROXY=0
