# Copia este archivo como .env.local y rellena lo que necesites.

# --- Transcripción -----------------------------------------------------------
# Opción A: API de OpenAI (Whisper). Si hay clave, se usa por defecto.
OPENAI_API_KEY=
# Modelo con marcas de tiempo por palabra (whisper-1). Para otro proveedor
# compatible con la API de OpenAI (p. ej. Groq: https://api.groq.com/openai/v1
# con whisper-large-v3) cambia también OPENAI_BASE_URL.
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_BASE_URL=https://api.openai.com/v1

# Opción B: whisper.cpp local (se usa si no hay OPENAI_API_KEY).
# Ruta al ejecutable (whisper-cli) y al modelo ggml. Si no se indican, se busca
# whisper-cli en el PATH y el mejor modelo ggml-*.bin dentro de ./models
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=
WHISPER_CPP_THREADS=4

# Forzar proveedor: openai | whispercpp (vacío = automático)
TRANSCRIBER=
# Idioma por defecto de la transcripción
DEFAULT_LANGUAGE=es
# Texto de contexto para que Whisper conserve muletillas ("eh", "mm"…)
# TRANSCRIPTION_PROMPT=Eh… mm, o sea, bueno, pues eh… este, mmm, vale.

# --- Rutas -------------------------------------------------------------------
# Datos de la app (clips subidos, proyectos, exportaciones)
STORAGE_DIR=./storage
# Carpeta de recursos de B-roll y música
BROLL_DIR=./recursos
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# Crear siempre una copia ligera para la vista previa (más fluida con muchos cortes)
ALWAYS_PROXY=0
